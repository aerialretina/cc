# Application
LIP_ENV=development
LIP_LOG_LEVEL=INFO

# Database (PostgreSQL with pgvector)
LIP_DATABASE_URL=postgresql+psycopg://lip:lip@localhost:5432/lip

# Redis (Celery broker + result backend)
LIP_REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally; S3 in prod)
LIP_S3_ENDPOINT=http://localhost:9000
LIP_S3_BUCKET=lip-raw
LIP_S3_ACCESS_KEY=minioadmin
LIP_S3_SECRET_KEY=minioadmin
LIP_S3_REGION=us-east-1

# Scraping
LIP_SCRAPE_USER_AGENT=LIPBot/0.1 (+https://example.com/bot)
LIP_PROXY_URL=

# Government data API keys
LIP_BLS_API_KEY=
LIP_STATCAN_API_KEY=
LIP_JOB_BANK_USER_ID=

# Geocoding
LIP_GEOCODER=
LIP_GEOCODER_API_KEY=
